<?xml version="1.0" encoding="utf-8"?>
<!-- Local machine paths. Edit this file, not the .csproj. -->
<Project>
    <!-- Windows build (Visual Studio / Rider on the Windows side). -->
    <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
        <ValheimGamePath>C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimGamePath>
        <BepInExPath>C:\Users\paulo\AppData\Roaming\com.kesomannen.gale\valheim\profiles\Default\BepInEx</BepInExPath>
        <CorlibPath>$(ValheimGamePath)\valheim_Data\Managed</CorlibPath>
        <!-- Gale installs this mod under plugins\OttoPay. A potto007-OttoPay folder there only holds a disabled copy. -->
        <CopyOutputDLLPath>$(BepInExPath)\plugins\OttoPay</CopyOutputDLLPath>
    </PropertyGroup>

    <!-- WSL / Linux build against the same Windows install through /mnt/c. -->
    <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
        <ValheimGamePath>/mnt/c/Program Files (x86)/Steam/steamapps/common/Valheim</ValheimGamePath>
        <BepInExPath>/mnt/c/Users/paulo/AppData/Roaming/com.kesomannen.gale/valheim/profiles/Default/BepInEx</BepInExPath>
        <CorlibPath>$(ValheimGamePath)/valheim_Data/Managed</CorlibPath>
        <CopyOutputDLLPath>$(BepInExPath)/plugins/OttoPay</CopyOutputDLLPath>
    </PropertyGroup>
</Project>
